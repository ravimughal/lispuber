server {
    listen 80;
    server_name lispuber.xyz;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name lispuber.xyz;
    root /home/apa/nginx;
    index index.html;

    # SSL
    ssl_certificate /etc/letsencrypt/live/lispuber.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lispuber.xyz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Assets
    location /js/ {
        root /home/apa/nginx;
        try_files $uri =404;
    }
    location /images/ {
        root /home/apa/nginx;
        try_files $uri =404;
    }
    location /css/ {
        root /home/apa/nginx;
        try_files $uri =404;
    }

    # API
    location /api/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 1s;
        proxy_read_timeout 3s;

        add_header X-Backend-Name $backend_name always;
        add_header X-Nginx-Name $nginx_name always;
    }

    # Languages
    location ~ ^/pt(/(.*))?$ {
        set $page $2;
        root /home/apa/nginx;
        try_files
            /html/pt/$page.html
            /html/pt/index.html
            =404;
    }

    location ~ ^/en(/(.*))?$ {
        set $page $2;
        root /home/apa/nginx;
        try_files
            /html/en/$page.html
            /html/en/index.html
            =404;
    }

    location / {
        set $page $uri;
        root /home/apa/nginx;
        try_files
            /html/en/$page.html
            /html/en/index.html
            =404;
    }
}